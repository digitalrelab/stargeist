{
  "name": "@stargeist/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Stargeist desktop app",
  "license": "Apache-2.0",
  "author": "digitalrelab",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "sg dev",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "test": "vp test run --root ../.. apps/sg-desktop/src --maxWorkers 2",
    "schema:generate": "bun generate-schema.ts"
  },
  "devDependencies": {
    "@effect/sql-sqlite-node": "4.0.0-rc.116",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@stargeist/ai": "workspace:*",
    "@stargeist/application": "workspace:*",
    "@stargeist/dev-tools": "workspace:*",
    "@stargeist/domain": "workspace:*",
    "@stargeist/protocol": "workspace:*",
    "@stargeist/renderer": "workspace:*",
    "@stargeist/std": "workspace:*",
    "@stargeist/storage": "workspace:*",
    "@types/electron-squirrel-startup": "1.0.2",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "catalog:",
    "electron": "44.4.3",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "mime": "4.1.0",
    "vite-plus": "catalog:"
  },
  "nx": {
    "tags": [
      "platform:linux",
      "platform:darwin",
      "platform:win32"
    ],
    "targets": {
      "ci:build": {
        "executor": "nx:run-script",
        "options": {
          "script": "make"
        }
      }
    }
  },
  "productName": "Stargeist"
}
