{
  "name": "@stargeist/renderer",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./vite": "./vite.config.ts"
  },
  "scripts": {
    "generate": "tsr generate",
    "build": "vp build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run --root ../.. apps/sg-renderer/src --maxWorkers 2"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.116",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@stargeist/ai": "workspace:*",
    "@stargeist/application": "workspace:*",
    "@stargeist/domain": "workspace:*",
    "@stargeist/protocol": "workspace:*",
    "@stargeist/std": "workspace:*",
    "@stargeist/ui": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-virtual": "3.14.13",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "vite-plus": "catalog:"
  },
  "nx": {
    "tags": [
      "platform:linux",
      "platform:darwin",
      "platform:win32"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "generate"
        ]
      }
    }
  }
}
