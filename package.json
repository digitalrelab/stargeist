{
  "name": "stargeist",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "postinstall": "bun run --cwd apps/sg-renderer generate",
    "dev": "sg dev",
    "build": "bun run package",
    "build:renderer": "bun run --cwd apps/sg-renderer build",
    "package": "bun run --cwd apps/sg-desktop package",
    "make": "bun run --cwd apps/sg-desktop make",
    "check": "vp check",
    "typecheck": "tsc --build",
    "fmt": "vp fmt",
    "test": "vp test run",
    "checks": "node tooling/checks/bin/checks.mjs",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@stargeist/checks": "workspace:*",
    "@stargeist/dev-tools": "workspace:*",
    "@types/node": "26.6.2",
    "nx": "23.2.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "vite": "catalog:",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@stylexjs/stylex": "0.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "effect": "4.0.0-rc.116",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3"
  },
  "nx": {
    "includedScripts": [
      "check",
      "typecheck:tools"
    ],
    "targets": {
      "typecheck:tools": {
        "dependsOn": [
          {
            "projects": [
              "@stargeist/renderer"
            ],
            "target": "generate"
          }
        ]
      }
    }
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller"
  ]
}
